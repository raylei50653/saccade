#!/usr/bin/env bash
# Saccade pre-commit hook: ruff format + check on staged Python files.
# Install: git config core.hooksPath .githooks

set -euo pipefail

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' '*.pyi')

if [ -z "$STAGED_PY" ]; then
    exit 0
fi

echo "==> ruff format (staged Python files)"
uv run ruff format --force-exclude $STAGED_PY

echo "==> ruff check (staged Python files)"
uv run ruff check --force-exclude $STAGED_PY

# Re-stage after formatting
git add $STAGED_PY

echo "==> pre-commit OK"
