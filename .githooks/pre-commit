#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

mapfile -t STAGED_PY_FILES < <(
    git diff --cached --name-only --diff-filter=ACMR | grep -E '\.pyi?$' || true
)

if [[ ${#STAGED_PY_FILES[@]} -eq 0 ]]; then
    exit 0
fi

echo "pre-commit: ruff format on staged Python files"
uv run ruff format "${STAGED_PY_FILES[@]}"
git add -- "${STAGED_PY_FILES[@]}"

echo "pre-commit: ruff check on staged Python files"
uv run ruff check "${STAGED_PY_FILES[@]}"
