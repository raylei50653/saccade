{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saccade.local/contracts/h2_execution_result_v1.json",
  "title": "H2 execution result v1",
  "description": "The result of one diagnostic or exactly-once measurement execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority",
    "authorization_binding_digest",
    "execution_id",
    "execution_semantics_projection_digest",
    "ordered_runs",
    "predicate_results",
    "resolved_run_spec_digest",
    "result",
    "run_plan",
    "schema",
    "terminal"
  ],
  "properties": {
    "schema": {
      "const": "h2_execution_result_v1"
    },
    "execution_id": {
      "$ref": "#/$defs/execution_id"
    },
    "authority": {
      "enum": [
        "non_qualifying_diagnostic",
        "exactly_once_measurement"
      ]
    },
    "authorization_binding_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved_run_spec_digest": {
      "$ref": "#/$defs/sha256"
    },
    "execution_semantics_projection_digest": {
      "$ref": "#/$defs/sha256"
    },
    "run_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_ids",
        "sequence"
      ],
      "properties": {
        "sequence": {
          "const": "MOT17-04-SDP"
        },
        "run_ids": {
          "const": [
            "00_capture_off",
            "01_capture_on",
            "02_capture_on",
            "03_capture_on"
          ]
        }
      }
    },
    "predicate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_input_unchanged",
        "capture_off_on_equal",
        "execution_complete",
        "packets_valid",
        "runtime_projection_matches_resolved_run_spec"
      ],
      "properties": {
        "bound_input_unchanged": {
          "$ref": "#/$defs/predicate_result"
        },
        "capture_off_on_equal": {
          "$ref": "#/$defs/predicate_result"
        },
        "execution_complete": {
          "$ref": "#/$defs/predicate_result"
        },
        "packets_valid": {
          "$ref": "#/$defs/predicate_result"
        },
        "runtime_projection_matches_resolved_run_spec": {
          "$ref": "#/$defs/predicate_result"
        }
      }
    },
    "ordered_runs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/capture_off_run"
        },
        {
          "$ref": "#/$defs/capture_on_1_run"
        },
        {
          "$ref": "#/$defs/capture_on_2_run"
        },
        {
          "$ref": "#/$defs/capture_on_3_run"
        }
      ],
      "items": false
    },
    "result": {
      "enum": [
        "measurement_pass",
        "input_mutated",
        "runtime_binding_mismatch",
        "capture_perturbs_policy",
        "packet_invalid",
        "build_failed",
        "extension_load_failed",
        "runner_nonzero",
        "runner_timeout",
        "serialization_failed",
        "artifact_missing_or_unreadable",
        "unclassified_execution_failure",
        "diagnostic_complete"
      ]
    },
    "terminal": {
      "oneOf": [
        {
          "enum": [
            "H2_INPUT_MUTATED_DURING_MEASUREMENT",
            "H2_CAPTURE_PERTURBS_POLICY",
            "H2_PACKET_INVALID",
            "H2_MEASUREMENT_EXECUTION_INVALID"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority": {
            "const": "non_qualifying_diagnostic"
          }
        },
        "required": [
          "authority"
        ]
      },
      "then": {
        "properties": {
          "authorization_binding_digest": {
            "type": "null"
          },
          "result": {
            "const": "diagnostic_complete"
          },
          "terminal": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "authorization_binding_digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "const": "exactly_once_measurement"
          }
        },
        "required": [
          "authority"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "not": {
              "const": "diagnostic_complete"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "input_mutated",
              "runtime_binding_mismatch"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "terminal": {
            "const": "H2_INPUT_MUTATED_DURING_MEASUREMENT"
          }
        },
        "required": [
          "terminal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "capture_perturbs_policy"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "terminal": {
            "const": "H2_CAPTURE_PERTURBS_POLICY"
          }
        },
        "required": [
          "terminal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "packet_invalid"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "terminal": {
            "const": "H2_PACKET_INVALID"
          }
        },
        "required": [
          "terminal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "build_failed",
              "extension_load_failed",
              "runner_nonzero",
              "runner_timeout",
              "serialization_failed",
              "artifact_missing_or_unreadable",
              "unclassified_execution_failure"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "terminal": {
            "const": "H2_MEASUREMENT_EXECUTION_INVALID"
          }
        },
        "required": [
          "terminal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "measurement_pass"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "exactly_once_measurement"
          },
          "terminal": {
            "type": "null"
          },
          "predicate_results": {
            "$ref": "#/$defs/all_predicates_pass"
          }
        },
        "required": [
          "authority",
          "predicate_results",
          "terminal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "terminal": {
            "type": "string"
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "not": {
              "$ref": "#/$defs/all_predicates_pass"
            }
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "input_mutated"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "properties": {
              "bound_input_unchanged": {
                "properties": {
                  "state": {
                    "const": "fail"
                  }
                }
              }
            },
            "required": [
              "bound_input_unchanged"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "runtime_binding_mismatch"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "properties": {
              "runtime_projection_matches_resolved_run_spec": {
                "properties": {
                  "state": {
                    "const": "fail"
                  }
                }
              },
              "bound_input_unchanged": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              }
            },
            "required": [
              "runtime_projection_matches_resolved_run_spec"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "capture_perturbs_policy"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "properties": {
              "capture_off_on_equal": {
                "properties": {
                  "state": {
                    "const": "fail"
                  }
                }
              },
              "bound_input_unchanged": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              },
              "runtime_projection_matches_resolved_run_spec": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              }
            },
            "required": [
              "capture_off_on_equal"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "packet_invalid"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "properties": {
              "packets_valid": {
                "properties": {
                  "state": {
                    "const": "fail"
                  }
                }
              },
              "bound_input_unchanged": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              },
              "runtime_projection_matches_resolved_run_spec": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              },
              "capture_off_on_equal": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              }
            },
            "required": [
              "packets_valid"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "build_failed",
              "extension_load_failed",
              "runner_nonzero",
              "runner_timeout",
              "serialization_failed",
              "artifact_missing_or_unreadable",
              "unclassified_execution_failure"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "properties": {
              "execution_complete": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "pass"
                    }
                  }
                }
              },
              "bound_input_unchanged": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              },
              "runtime_projection_matches_resolved_run_spec": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              },
              "capture_off_on_equal": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              },
              "packets_valid": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "fail"
                    }
                  }
                }
              }
            },
            "required": [
              "execution_complete"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "predicate_results": {
                "properties": {
                  "bound_input_unchanged": {
                    "properties": {
                      "state": {
                        "$ref": "#/$defs/undecided_state"
                      }
                    }
                  }
                },
                "required": [
                  "bound_input_unchanged"
                ]
              }
            },
            "required": [
              "predicate_results"
            ]
          },
          {
            "properties": {
              "predicate_results": {
                "properties": {},
                "required": []
              }
            },
            "required": [
              "predicate_results"
            ]
          },
          {
            "properties": {
              "predicate_results": {
                "properties": {
                  "runtime_projection_matches_resolved_run_spec": {
                    "properties": {
                      "state": {
                        "$ref": "#/$defs/undecided_state"
                      }
                    }
                  }
                },
                "required": [
                  "runtime_projection_matches_resolved_run_spec"
                ]
              }
            },
            "required": [
              "predicate_results"
            ]
          },
          {
            "properties": {
              "predicate_results": {
                "properties": {
                  "capture_off_on_equal": {
                    "properties": {
                      "state": {
                        "$ref": "#/$defs/undecided_state"
                      }
                    }
                  }
                },
                "required": [
                  "capture_off_on_equal"
                ]
              }
            },
            "required": [
              "predicate_results"
            ]
          },
          {
            "properties": {
              "predicate_results": {
                "properties": {
                  "packets_valid": {
                    "properties": {
                      "state": {
                        "$ref": "#/$defs/undecided_state"
                      }
                    }
                  }
                },
                "required": [
                  "packets_valid"
                ]
              }
            },
            "required": [
              "predicate_results"
            ]
          },
          {
            "properties": {
              "predicate_results": {
                "properties": {
                  "execution_complete": {
                    "properties": {
                      "state": {
                        "$ref": "#/$defs/undecided_state"
                      }
                    }
                  }
                },
                "required": [
                  "execution_complete"
                ]
              }
            },
            "required": [
              "predicate_results"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "predicate_results": {
            "properties": {
              "execution_complete": {
                "properties": {
                  "state": {
                    "not": {
                      "const": "pass"
                    }
                  }
                }
              }
            },
            "required": [
              "execution_complete"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "predicate_results": {
            "properties": {
              "execution_complete": {
                "properties": {
                  "state": {
                    "const": "pass"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "execution_complete"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      },
      "then": {
        "properties": {
          "ordered_runs": {
            "$ref": "#/$defs/all_runs_completed"
          }
        },
        "required": [
          "ordered_runs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "predicate_results": {
            "properties": {
              "capture_off_on_equal": {
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail"
                    ]
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "capture_off_on_equal"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "ordered_runs": {
                "prefixItems": [
                  {
                    "properties": {
                      "state": {
                        "not": {
                          "const": "not_run"
                        }
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                ]
              }
            },
            "required": [
              "ordered_runs"
            ]
          },
          {
            "properties": {
              "ordered_runs": {
                "contains": {
                  "allOf": [
                    {
                      "properties": {
                        "run_id": {
                          "not": {
                            "const": "00_capture_off"
                          }
                        }
                      },
                      "required": [
                        "run_id"
                      ]
                    },
                    {
                      "properties": {
                        "state": {
                          "not": {
                            "const": "not_run"
                          }
                        }
                      },
                      "required": [
                        "state"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "ordered_runs"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "predicate_results": {
            "properties": {
              "packets_valid": {
                "properties": {
                  "state": {
                    "enum": [
                      "pass",
                      "fail"
                    ]
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "packets_valid"
            ]
          }
        },
        "required": [
          "predicate_results"
        ]
      },
      "then": {
        "properties": {
          "ordered_runs": {
            "contains": {
              "allOf": [
                {
                  "properties": {
                    "run_id": {
                      "not": {
                        "const": "00_capture_off"
                      }
                    }
                  },
                  "required": [
                    "run_id"
                  ]
                },
                {
                  "properties": {
                    "state": {
                      "not": {
                        "const": "not_run"
                      }
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "ordered_runs"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "predicate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasons",
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pass",
            "fail",
            "error",
            "not_run"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "run_id",
        "state"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "completed",
            "failed",
            "not_run"
          ]
        },
        "artifact_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "artifact_digest": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "artifact_digest"
            ]
          }
        }
      ]
    },
    "capture_off_run": {
      "allOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "properties": {
            "run_id": {
              "const": "00_capture_off"
            }
          }
        }
      ]
    },
    "capture_on_1_run": {
      "allOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "properties": {
            "run_id": {
              "const": "01_capture_on"
            }
          }
        }
      ]
    },
    "capture_on_2_run": {
      "allOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "properties": {
            "run_id": {
              "const": "02_capture_on"
            }
          }
        }
      ]
    },
    "capture_on_3_run": {
      "allOf": [
        {
          "$ref": "#/$defs/run"
        },
        {
          "properties": {
            "run_id": {
              "const": "03_capture_on"
            }
          }
        }
      ]
    },
    "all_predicates_pass": {
      "type": "object",
      "required": [
        "bound_input_unchanged",
        "runtime_projection_matches_resolved_run_spec",
        "capture_off_on_equal",
        "packets_valid",
        "execution_complete"
      ],
      "properties": {
        "bound_input_unchanged": {
          "properties": {
            "state": {
              "const": "pass"
            }
          }
        },
        "runtime_projection_matches_resolved_run_spec": {
          "properties": {
            "state": {
              "const": "pass"
            }
          }
        },
        "capture_off_on_equal": {
          "properties": {
            "state": {
              "const": "pass"
            }
          }
        },
        "packets_valid": {
          "properties": {
            "state": {
              "const": "pass"
            }
          }
        },
        "execution_complete": {
          "properties": {
            "state": {
              "const": "pass"
            }
          }
        }
      }
    },
    "undecided_state": {
      "enum": [
        "error",
        "not_run"
      ]
    },
    "all_runs_completed": {
      "type": "array",
      "items": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      }
    }
  }
}
