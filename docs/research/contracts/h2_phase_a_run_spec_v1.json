{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saccade.local/contracts/h2_phase_a_run_spec_v1.json",
  "title": "H2 Phase-A resolved RunSpec v1",
  "description": "The complete canonical evaluator namespace issued from the frozen owner-adjudicated profile and used as the sole execution-configuration authority for H2 Phase A.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_serialization",
    "authoring_profile",
    "execution_semantics_projection",
    "execution_semantics_projection_digest",
    "namespace_schema",
    "object_canonicalization",
    "phase",
    "resolved_namespace",
    "resolved_namespace_digest",
    "resolved_namespace_keys",
    "resolved_run_spec_digest",
    "schema"
  ],
  "properties": {
    "authoring_profile": {
      "$ref": "#/$defs/authoring_profile"
    },
    "schema": {
      "const": "h2_phase_a_run_spec_v1"
    },
    "phase": {
      "const": "phase_a"
    },
    "namespace_schema": {
      "const": "mot17_args_resolved_namespace_v1"
    },
    "object_canonicalization": {
      "const": "utf8_lexicographic_keys_compact_finite_no_trailing_lf_v1"
    },
    "artifact_serialization": {
      "const": "utf8_lexicographic_keys_compact_finite_single_trailing_lf_v1"
    },
    "resolved_namespace": {
      "type": "object",
      "minProperties": 454,
      "maxProperties": 454,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "properties": {
        "preset": {
          "type": "null"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "resolved_namespace_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "resolved_namespace_digest": {
      "$ref": "#/$defs/sha256"
    },
    "resolved_run_spec_digest": {
      "$ref": "#/$defs/sha256"
    },
    "execution_semantics_projection_digest": {
      "$ref": "#/$defs/sha256"
    },
    "execution_semantics_projection": {
      "$ref": "#/$defs/execution_semantics_projection"
    }
  },
  "$defs": {
    "authoring_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring_lineage",
        "owner_decision",
        "owner_decision_sha256",
        "profile",
        "profile_schema",
        "profile_schema_sha256",
        "profile_sha256",
        "schema"
      ],
      "properties": {
        "schema": {
          "const": "h2_run_spec_authoring_binding_v1"
        },
        "profile": {
          "const": "docs/research/contracts/h2_phase_a_authoring_profile_v1.json"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_schema": {
          "const": "docs/research/contracts/h2_phase_a_authoring_profile_v1.schema.json"
        },
        "profile_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_decision": {
          "const": "docs/research/contracts/h2_phase_a_run_spec_authoring_decision_v1.json"
        },
        "owner_decision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoring_lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derived_from",
            "resolution",
            "runtime_preset_loader",
            "source_sha256"
          ],
          "properties": {
            "derived_from": {
              "const": "configs/presets/mamba_whole_graph_m.yaml"
            },
            "resolution": {
              "const": "one_time_parser_resolution_plus_owner_adjudication"
            },
            "runtime_preset_loader": {
              "const": false
            },
            "source_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "json_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        }
      ]
    },
    "content_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "closure_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "description": "A closure member may be zero-length. src/saccade/__init__.py is empty, ordinary Python and genuinely imported; the alternative repair \u2014 skipping empty files \u2014 would have put the first exception into a rule that has none."
    },
    "execution_code_closure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every file the working tree carries under the declared roots, digested as one content set. The named member list above is tooling a reviewer can enumerate; this is the code that computes a tracking result, which is not enumerable that way. Without it two records could share one projection digest and have run different trackers. Roots, not names: a hand-written list of the obviously relevant modules omitted src/saccade/perception/eval/post_merge.py, the home of interpolate_tracklets, whose behaviour produced the W4b finding. scripts/ joined the roots after the first witnessed execution found seventeen loaded repository files that no content set bound, among them the module defining the canonicalization every digest here rests on and the function selecting which evaluator stack loads. It is the whole of scripts/ rather than the subdirectories that happened to appear in that import graph: choosing roots from an observed call path is the same error as choosing names from one. The cost is conservative failure -- unrelated edits move this digest and force a republish -- which is the sound direction to fail in.",
      "required": [
        "algorithm",
        "digest",
        "members",
        "roots",
        "schema",
        "selector"
      ],
      "properties": {
        "schema": {
          "const": "h2_execution_code_closure_v1"
        },
        "selector": {
          "const": "git_tracked_and_unignored_files_under_declared_roots_v1",
          "description": "Present and unignored, not merely committed: a file an author has not yet committed is still a file the interpreter can import."
        },
        "algorithm": {
          "const": "sha256_canonical_json_content_members_v1"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_./-]+/$"
          },
          "description": "Declared literally here and in the resolver. This content set never consults a path classification: a path class is a governance verdict about what an edit means, and this is a set of bytes. A root declares which repository source is allowed to take part in an execution; which of it actually did is the import witness's subject, and neither may be derived from the other."
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/closure_member"
          },
          "description": "Sorted by path, no extension filter. A rule with exceptions is a rule an editor may work in."
        }
      }
    },
    "execution_semantics_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "execution_code_closure",
        "members",
        "schema"
      ],
      "properties": {
        "schema": {
          "const": "h2_execution_semantics_projection_v2"
        },
        "algorithm": {
          "const": "sha256_canonical_json_named_members_and_code_closure_v1",
          "description": "The digest covers the named members and the closure digest together. The v1 identifiers are not permitted aliases: the digest's domain changed, and a changed meaning may not keep the old name (Correction 7)."
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/content_member"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "docs/research/contracts/h2_import_witness_v1.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "docs/research/contracts/h2_phase_a_authoring_profile_v1.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "docs/research/contracts/h2_phase_a_authoring_profile_v1.schema.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "docs/research/contracts/h2_phase_a_run_spec_authoring_decision_v1.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "docs/research/contracts/h2_phase_a_run_spec_v1.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/eval/mot17_args.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/check_h2_measure_archives.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/h0_bridge_decision_trace_schema_v2.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/h2_measurement_evidence.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/h2_run_spec.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/run_h2_measurement.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/run_h2_measurement_child.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/verify_h0_phase_a.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/verify_h2_measurement.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "scripts/tools/verify_headline_bridge_decision_trace.py"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ]
        },
        "execution_code_closure": {
          "$ref": "#/$defs/execution_code_closure"
        }
      },
      "description": "Since scripts/ became a root the two halves overlap: five named members live under it and are therefore also closure members, so their bytes are bound twice and folded into this digest through both halves. That is deliberate and lossless, not an accident of the wider roots, and it is stated here so a later reader does not remove it as redundancy. Widening the root tuple changes which files the closure holds, which is instance data; changing how the two halves fold together would change the algorithm, and would have to take a new algorithm name."
    }
  }
}
