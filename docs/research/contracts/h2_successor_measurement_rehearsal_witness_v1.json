{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saccade.local/contracts/h2_successor_measurement_rehearsal_witness_v1.json",
  "title": "H2 successor measurement rehearsal witness v1",
  "description": "A non-authoritative witness that the real successor controller, both independent verifiers and the canonical corpus refusal boundary completed against a disposable authorization ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_admission",
    "envelope_valid",
    "execution_id",
    "grant_digest",
    "inner_valid",
    "packet",
    "receipt_digest",
    "result",
    "schema",
    "terminal"
  ],
  "properties": {
    "schema": {
      "const": "h2_successor_measurement_rehearsal_witness_v1"
    },
    "corpus_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted",
        "reasons"
      ],
      "properties": {
        "admitted": {
          "const": false
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "envelope_valid": {
      "const": true
    },
    "execution_id": {
      "$ref": "#/$defs/execution_id"
    },
    "grant_digest": {
      "$ref": "#/$defs/sha256"
    },
    "inner_valid": {
      "const": true
    },
    "packet": {
      "type": "string",
      "minLength": 1
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "const": "measurement_pass"
    },
    "terminal": {
      "type": "null"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
