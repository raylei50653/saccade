{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h0_gctm_guarantee_registration_v2",
  "title": "H0 to GCTM guarantee registration for the full candidate-source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "record_scope",
    "record_state",
    "consumer"
  ],
  "properties": {
    "schema": {
      "const": "h0_gctm_guarantee_registration_v2"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,127}$"
    },
    "record_scope": {
      "enum": [
        "fixture_only",
        "actual"
      ]
    },
    "record_state": {
      "enum": [
        "candidate-source",
        "registered-guarantee"
      ]
    },
    "consumer": {
      "$ref": "#/$defs/consumer"
    },
    "candidate_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidate_source"
      }
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "guarantees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/guarantee"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_state": {
            "const": "candidate-source"
          }
        }
      },
      "then": {
        "required": [
          "candidate_sources"
        ],
        "properties": {
          "record_scope": {
            "const": "fixture_only"
          },
          "baseline": false,
          "guarantees": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_state": {
            "const": "registered-guarantee"
          }
        }
      },
      "then": {
        "required": [
          "baseline",
          "guarantees"
        ],
        "properties": {
          "record_scope": {
            "const": "actual"
          },
          "candidate_sources": false
        }
      }
    }
  ],
  "$defs": {
    "pair_instance_key": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "const": "seq" },
        { "const": "frame" },
        { "const": "cand_slot" },
        { "const": "cand_instance_uid" },
        { "const": "lost_slot" },
        { "const": "lost_instance_uid" }
      ],
      "items": false
    },
    "field_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,127}$"
      }
    },
    "consumer_object": {
      "enum": [
        "event_runtime_instance_identity",
        "native_exit_entry_snapshot",
        "operational_horizon_observation_point",
        "candidate_competition_pair_score_context",
        "claim_commit_audit_boundary"
      ]
    },
    "stream": {
      "enum": [
        "pair_record",
        "candidate_record",
        "claim_record",
        "commit_record"
      ]
    },
    "object_stream_coupling": {
      "allOf": [
        {
          "if": {
            "properties": {
              "consumer_object": {
                "const": "event_runtime_instance_identity"
              }
            }
          },
          "then": {
            "properties": {
              "stream": {
                "const": "pair_record"
              },
              "causal_availability": {
                "const": "online"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_object": {
                "const": "native_exit_entry_snapshot"
              }
            }
          },
          "then": {
            "properties": {
              "stream": {
                "const": "pair_record"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_object": {
                "const": "operational_horizon_observation_point"
              }
            }
          },
          "then": {
            "properties": {
              "stream": {
                "const": "pair_record"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_object": {
                "const": "candidate_competition_pair_score_context"
              }
            }
          },
          "then": {
            "properties": {
              "stream": {
                "enum": [
                  "pair_record",
                  "candidate_record"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consumer_object": {
                "const": "claim_commit_audit_boundary"
              }
            }
          },
          "then": {
            "properties": {
              "stream": {
                "enum": [
                  "claim_record",
                  "commit_record"
                ]
              }
            }
          }
        }
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "maximum_claim_layer",
        "required_guarantee_ids"
      ],
      "properties": {
        "consumer_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$"
        },
        "maximum_claim_layer": {
          "enum": [
            "gctm_model_specification",
            "bridge_runtime_b1"
          ]
        },
        "required_guarantee_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,127}$"
          }
        }
      }
    },
    "candidate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "consumer_object",
        "stream",
        "source_fields",
        "causal_availability"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$"
        },
        "consumer_object": {
          "$ref": "#/$defs/consumer_object"
        },
        "stream": {
          "$ref": "#/$defs/stream"
        },
        "source_fields": {
          "$ref": "#/$defs/field_list"
        },
        "causal_availability": {
          "enum": [
            "online",
            "lagged",
            "offline_only"
          ]
        }
      },
      "$comment": "Per-object stream coupling and field allowlists are enforced by the validator against the sealed capture ABI.",
      "allOf": [
        {
          "$ref": "#/$defs/object_stream_coupling"
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "h0_terminal",
        "h0_evidence_id",
        "h0_packet_hash",
        "h0_schema_version",
        "runtime_instrumentation_identity",
        "policy_base_id",
        "resolved_preset_id",
        "capture_mode",
        "event_key_version",
        "observation_state_semantics_version",
        "dataset_sequence_domain",
        "accepted_by",
        "accepted_at"
      ],
      "properties": {
        "baseline_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$"
        },
        "h0_terminal": {
          "const": "H0_FULL_COMMIT_CAPTURE_FAITHFUL"
        },
        "h0_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "h0_packet_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "h0_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_instrumentation_identity": {
          "type": "string",
          "minLength": 1
        },
        "policy_base_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved_preset_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_mode": {
          "type": "string",
          "minLength": 1
        },
        "event_key_version": {
          "type": "string",
          "minLength": 1
        },
        "observation_state_semantics_version": {
          "type": "string",
          "minLength": 1
        },
        "dataset_sequence_domain": {
          "type": "string",
          "minLength": 1
        },
        "accepted_by": {
          "const": "h0_owner"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "guarantee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guarantee_id",
        "guarantee_class",
        "consumer_object",
        "stream",
        "covered_fields",
        "relation",
        "causal_availability",
        "declared_domain",
        "basis",
        "invalidation_inputs"
      ],
      "properties": {
        "guarantee_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$"
        },
        "guarantee_class": {
          "enum": [
            "identity",
            "snapshot",
            "timing",
            "competition",
            "audit"
          ]
        },
        "consumer_object": {
          "$ref": "#/$defs/consumer_object"
        },
        "stream": {
          "$ref": "#/$defs/stream"
        },
        "covered_fields": {
          "$ref": "#/$defs/field_list"
        },
        "relation": {
          "enum": [
            "exact",
            "derived"
          ]
        },
        "causal_availability": {
          "enum": [
            "online",
            "lagged",
            "offline_only"
          ]
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition_id",
            "definition_version",
            "content_hash"
          ],
          "properties": {
            "definition_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,127}$"
            },
            "definition_version": {
              "type": "string",
              "minLength": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "declared_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preset_id",
            "runtime_identity",
            "schema_id",
            "dataset_sequence_domain"
          ],
          "properties": {
            "preset_id": {
              "type": "string",
              "minLength": 1
            },
            "runtime_identity": {
              "type": "string",
              "minLength": 1
            },
            "schema_id": {
              "type": "string",
              "minLength": 1
            },
            "dataset_sequence_domain": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "replay",
              "shadow_nonperturbation"
            ]
          }
        },
        "invalidation_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/object_stream_coupling"
        },
        {
          "if": {
            "properties": {
              "relation": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "derivation"
            ]
          },
          "else": {
            "properties": {
              "derivation": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "guarantee_class": {
                "const": "identity"
              }
            }
          },
          "then": {
            "properties": {
              "consumer_object": {
                "const": "event_runtime_instance_identity"
              },
              "relation": {
                "const": "exact"
              },
              "covered_fields": {
                "$ref": "#/$defs/pair_instance_key"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "guarantee_class": {
                "const": "snapshot"
              }
            }
          },
          "then": {
            "properties": {
              "consumer_object": {
                "const": "native_exit_entry_snapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "guarantee_class": {
                "const": "timing"
              }
            }
          },
          "then": {
            "properties": {
              "consumer_object": {
                "const": "operational_horizon_observation_point"
              },
              "relation": {
                "const": "exact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "guarantee_class": {
                "const": "competition"
              }
            }
          },
          "then": {
            "properties": {
              "consumer_object": {
                "const": "candidate_competition_pair_score_context"
              },
              "relation": {
                "const": "exact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "guarantee_class": {
                "const": "audit"
              }
            }
          },
          "then": {
            "properties": {
              "consumer_object": {
                "const": "claim_commit_audit_boundary"
              },
              "relation": {
                "const": "exact"
              }
            }
          }
        }
      ]
    }
  }
}
