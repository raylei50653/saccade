        },
        "inventory_digest": {
          "$ref": "#/definitions/sha256_hex"
        },
        "equal_to_t0": {
          "type": "boolean"
        },
        "monotonic_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cdv_set_name": {
      "type": "string",
      "enum": [
        "C",
        "D",
        "V"
      ]
