        "inotify_mask": {
          "type": "integer",
          "const": 4046
        },
        "inotify_mask_names": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "IN_CLOSE_WRITE",
              "IN_MODIFY",
              "IN_ATTRIB",
              "IN_DELETE_SELF",
              "IN_MOVE_SELF",
              "IN_CREATE",
              "IN_DELETE",
              "IN_MOVED_FROM",
              "IN_MOVED_TO"
