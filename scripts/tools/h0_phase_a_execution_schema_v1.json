        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256_hex"
        }
      }
    },
    "h0_bound_inputs_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "instrumentation_head",
        "repository",
        "models_engines",
        "sequence",
        "tool_runtime_inputs",
        "inventory_digest"
      ],
      "properties": {
