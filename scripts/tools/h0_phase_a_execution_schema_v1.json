{
  "schema_id": "h0_phase_a_execution_v1",
  "schema_version": "h0_phase_a_execution_v1",
  "description": "Frozen A7 + RC1 Phase-A controller execution contract. Strict, unknown-field closed, no free-text mechanical verdicts.",
  "additionalProperties": false,
  "definitions": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instrumentation_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "posix_abs_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "posix_rel_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*"
    },
    "run_id": {
      "type": "string",
      "enum": [
        "00_capture_off",
        "01_capture_on_1",
        "02_capture_on_2",
        "03_capture_on_3"
      ]
    },
    "controller_result": {
      "type": "string",
      "enum": [
        "provenance_invalid",
        "build_failed",
        "extension_load_failed",
        "runner_nonzero",
        "runner_timeout",
        "serialization_failed",
        "artifact_missing_or_unreadable",
        "unclassified_execution_failure",
        "capture_perturbs_policy",
        "packet_invalid",
        "phase_a_pass"
      ]
    },
    "invocation_state": {
      "type": "string",
      "enum": [
        "not_run",
        "running_interrupted",
        "failed",
        "completed"
      ]
    },
    "artifact_state": {
      "type": "string",
      "enum": [
        "not_produced",
        "produced"
      ]
    },
    "mutation_class": {
      "type": "string",
      "enum": [
        "none",
        "bound_path_mutation",
        "ancestor_move_or_delete",
        "watch_install_failure",
        "queue_overflow",
        "ignored_watch",
        "unclassified_monitor_failure"
      ]
    },
    "checkpoint_id": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2a",
        "T2b",
        "T3",
        "T4"
      ]
    },
    "command_vector": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "additionalItems": false
    },
    "ordered_run_plan": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/run_id"
      },
      "minItems": 4,
      "maxItems": 4,
      "additionalItems": false
    },
    "environment_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CUDA_DEVICE_ORDER",
        "CUDA_VISIBLE_DEVICES",
        "HOME",
        "LANG",
        "LC_ALL",
        "LD_LIBRARY_PATH",
        "PATH",
        "PYTHONHASHSEED",
        "PYTHONNOUSERSITE",
        "SACCADE_BUILD_PATH",
        "SACCADE_DETECT_BARRIER",
        "SACCADE_DOUBLE_BUFFER",
        "SACCADE_GPU_DECODE",
        "SACCADE_MAIN_NMS_GRAPHED",
        "TMPDIR",
        "TZ",
        "XDG_CACHE_HOME"
      ],
      "properties": {
        "CUDA_DEVICE_ORDER": {
          "type": "string",
          "const": "PCI_BUS_ID"
        },
        "CUDA_VISIBLE_DEVICES": {
          "type": "string",
          "minLength": 1
        },
        "HOME": {
          "$ref": "#/definitions/posix_abs_path"
        },
        "LANG": {
          "type": "string",
          "const": "C.UTF-8"
        },
        "LC_ALL": {
          "type": "string",
          "const": "C.UTF-8"
        },
        "LD_LIBRARY_PATH": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^:]+(/[^:]+)*:[^:]+(/[^:]+)*:[^:]+(/[^:]+)*:[^:]+(/[^:]+)*$"
        },
        "PATH": {
          "type": "string",
          "minLength": 1
        },
        "PYTHONHASHSEED": {
          "type": "string",
          "const": "0"
        },
        "PYTHONNOUSERSITE": {
          "type": "string",
          "const": "1"
        },
        "SACCADE_BUILD_PATH": {
          "$ref": "#/definitions/posix_abs_path"
        },
        "SACCADE_DETECT_BARRIER": {
          "type": "string",
          "const": "event"
        },
        "SACCADE_DOUBLE_BUFFER": {
          "type": "string",
          "const": "1"
        },
        "SACCADE_GPU_DECODE": {
          "type": "string",
          "const": "1"
        },
        "SACCADE_MAIN_NMS_GRAPHED": {
          "type": "string",
          "const": "1"
        },
        "TMPDIR": {
          "$ref": "#/definitions/posix_abs_path"
        },
        "TZ": {
          "type": "string",
          "const": "UTC"
        },
        "XDG_CACHE_HOME": {
          "$ref": "#/definitions/posix_abs_path"
        }
      }
    },
    "sequence_file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/definitions/sha256_hex"
        }
      }
    },
    "canonical_sequence_input_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sequence_root",
        "excluded_subtrees",
        "file_records",
        "aggregate_sha256"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "h0_sequence_input_digest_v1"
        },
        "sequence_root": {
          "type": "string",
          "const": "datasets/MOT17/train/MOT17-04-SDP"
        },
        "excluded_subtrees": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gt",
              "det"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false
        },
        "file_records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sequence_file_record"
          }
        },
        "aggregate_sha256": {
          "$ref": "#/definitions/sha256_hex"
        }
      }
    },
    "repository_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "object_type",
        "object_id",
        "path",
        "byte_length",
        "content_sha256_or_target"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{6}$"
        },
        "object_type": {
          "type": "string",
          "enum": [
            "blob",
            "tree",
            "commit"
          ]
        },
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256_or_target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model_engine_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_path",
        "realpath",
        "symlink_chain",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "logical_path": {
          "type": "string",
          "minLength": 1
        },
        "realpath": {
          "$ref": "#/definitions/posix_abs_path"
        },
        "symlink_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/definitions/sha256_hex"
        }
      }
    },
    "tool_runtime_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
